POSTGRES_DB=foodgram
POSTGRES_USER=foodgram
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DB_HOST=db
DB_PORT=5432
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-server-ip,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://your-server-ip
FOODGRAM_PAGE_SIZE=6
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
DOCKERHUB_USERNAME=your-dockerhub-login
FOODGRAM_ADMIN_USERNAME=foodgram_admin
FOODGRAM_ADMIN_EMAIL=admin@foodgram.local
FOODGRAM_ADMIN_PASSWORD=use-the-same-password-as-in-tests-yml
